{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comment-intel-comment-record",
  "title": "Normalized PR/MR comment",
  "type": "object",
  "required": [
    "id",
    "provider",
    "host",
    "repo",
    "pr_number",
    "kind",
    "created_at",
    "body"
  ],
  "properties": {
    "id": { "type": "string" },
    "provider": {
      "type": "string",
      "enum": ["github", "gitlab", "bitbucket", "gitea", "local"]
    },
    "host": { "type": "string" },
    "repo": { "type": "string" },
    "pr_number": { "type": "integer" },
    "pr_title": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["issue_comment", "review_comment", "review_summary", "note", "diff_note"]
    },
    "thread_id": { "type": ["string", "null"] },
    "author": { "type": ["string", "null"] },
    "author_type": {
      "type": "string",
      "enum": ["user", "bot", "deleted"]
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": ["string", "null"] },
    "body": { "type": "string" },
    "body_normalized": { "type": "string" },
    "path": { "type": ["string", "null"] },
    "line": { "type": ["integer", "null"] },
    "side": { "type": ["string", "null"] },
    "url": { "type": ["string", "null"] },
    "in_reply_to": { "type": ["string", "null"] }
  }
}
