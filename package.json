    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framedparadox/pr-comments.git"
  },
  "homepage": "https://github.com/framedparadox/pr-comments#readme",
  "bugs": {
    "url": "https://github.com/framedparadox/pr-comments/issues"
  },
  "author": "framedparadox",
  "keywords": [
    "agent-skills",
