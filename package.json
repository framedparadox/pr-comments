{
  "name": "pr-comments",
  "version": "1.0.0",
  "description": "Agent skills and CLI that extract pull request comments into CSV and a local review dashboard.",
  "bin": {
    "pr-comments": "bin/pr-comments.js"
  },
  "files": [
